@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Re-find dependencies for consumers
find_dependency(latero 0.2 REQUIRED)
find_dependency(ImageMagick REQUIRED COMPONENTS Magick++ )

find_dependency(PkgConfig REQUIRED)
pkg_check_modules(GTKMM REQUIRED IMPORTED_TARGET gtkmm-4.0)
pkg_check_modules(LIBXML REQUIRED IMPORTED_TARGET libxml++-5.0)

include("${CMAKE_CURRENT_LIST_DIR}/laterographicsTargets.cmake")



